# local.env.example - vzor nejvyssi vrstvy konfigurace
#
# Zkopiruj na local.env a uprav:
#
#     cp local.env.example local.env
#
# local.env NENI v repu (je v .gitignore) a prepisuje vsechny ostatni
# vrstvy. Je to misto pro nastaveni jedne konkretni desky na stole -
# ne pro zmeny, ktere maji platit pro vsechny. Ty patri do
# config/default.env nebo do profilu v config/board/ a config/vehicle/.
#
# Platny je tu kterykoli klic z config/default.env a zadny jiny -
# neznamy klic build zastavi i s napovedou, ktery jsi asi myslel.
# Cely seznam klicu a jejich vyznam: config/README.md
#
# Vsechny radky nize jsou zakomentovane. Odkomentuj si jen to,
# co opravdu menis - tabulka na zacatku buildu pak jasne ukaze,
# co z local.env pochazi.


# --- zapis do ridicich jednotek ------------------------------------
#
# Nez tohle odkomentujes, precti si docs/safety.md. Zapis muze vuz
# nevratne vyradit z provozu. 1 neznamena "zapis povolen", ale
# "zapisovy kod je v obrazu a je za branou".

#CANOGRAF_ALLOW_WRITE=on

# Vyvojovy rezim: brana prelozena otevrena, zadna odemykaci sekvence.
# Nikdy ne v obrazu, ktery nekomu das. Vyzaduje ALLOW_WRITE=on.
#CANOGRAF_WRITE_UNLOCKED=on


# --- jine auto nebo jina deska --------------------------------------

#CANOGRAF_VEHICLE=x82-trafic3-talento
#CANOGRAF_BOARD=waveshare-esp32s3-touch-lcd-4.3b


# --- jazyk rozhrani po prvnim startu --------------------------------
#
# "en", "cs" nebo "de"

#CANOGRAF_DEFAULT_LANG="cs"


# --- moduly ---------------------------------------------------------
#
# Zatim jen drzi misto, nic z toho jeste neexistuje.

#CANOGRAF_MOD_WEB=on
#CANOGRAF_MOD_ELM327=on
#CANOGRAF_MOD_SDLOG=on


# --- mereni klidoveho odberu misto rozhrani -------------------------
#
# Zapnute to NENI diagnostika: deska misto UI projde kroky mereni a
# vypise je do seriove linky. Patri to sem a nikam jinam - v repu by to
# znamenalo, ze si nekdo nahraje do auta merak.
#
# Nez cisla nekam zapises, precti si hlavicku src/sleep_test.cpp:
# meri se 5V vetev z USB, ne proud z baterie.

#CANOGRAF_SLEEP_TEST=on
