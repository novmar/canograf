# Profil vozidla: Renault X82
#
# Jedna platforma, ctyri znacky: Renault Trafic III, Fiat Talento,
# Opel Vivaro B, Nissan NV300. Overeno na Fiatu Talento 2020,
# 2.0 diesel, ridici jednotka motoru Bosch MD1CS006 (7A00 / 5P00).
#
# Mapa datovych identifikatoru, adresy vsech jednotek a zapisove bloky:
#   docs/vehicles/x82-trafic3-talento.md
#
# Zapina se v config/default.env nebo v local.env:
#   CANOGRAF_VEHICLE=x82-trafic3-talento
#
# Smi tu byt jen klice, ktere opravdu zavisi na vozidle. Vse ostatni
# patri do config/default.env.

# Jmeno pro cloveka. Zamerne jmeno platformy, ne jedne znacky - stejny
# profil plati pro Trafic, Talento, Vivaro i NV300.
CANOGRAF_VEHICLE_NAME="Renault X82"

# Diagnosticka sbernice: jeden segment HS CAN, 500 kbit/s, 11 bitu,
# dostupny z OBD konektoru na pinech 6 a 14.
CANOGRAF_CAN_BITRATE=500000

# Ridici jednotka motoru (ECM), UDS. Ostatni jednotky teto platformy
# mluvi starsim protokolem Renault - viz tabulka v docs/vehicles/.
CANOGRAF_ECU_TX_ID=0x7E0
CANOGRAF_ECU_RX_ID=0x7E8
