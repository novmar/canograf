# Profil vozidla: <platforma, znacky, motorizace>
#
# <na cem to bylo overeno: rok, motor, ridici jednotka, verze softwaru>
#
# Mapa datovych identifikatoru je dokumentace, ne konfigurace - patri do
# docs/vehicles/<soubor>.md. Sem jdou jen hodnoty, ktere potrebuje
# preklad: jak se jednotka jmenuje a kde na sbernici sedi.
#
# Nove vozidlo pridas takto:
#   1. zmer a sepis docs/vehicles/<platforma>.md - bez toho je profil
#      k nicemu, znalost identifikatoru je ta draha cast
#   2. zkopiruj tenhle soubor na config/vehicle/<platforma>.env
#   3. vypln hodnoty nize
#   4. zapni profil: CANOGRAF_VEHICLE=<platforma> v local.env nebo v
#      config/default.env
#
# Soubory s koncovkou .env.template se jako profil nenacitaji, jsou to
# jen vzory. Klic, ktery neni v config/default.env, build zastavi.

# jmeno pro cloveka, ukazuje se v rozhrani
CANOGRAF_VEHICLE_NAME="<jmeno platformy>"

# rychlost diagnosticke sbernice v bitech za sekundu
CANOGRAF_CAN_BITRATE=500000

# adresy ridici jednotky motoru, 11 bitu
CANOGRAF_ECU_TX_ID=0x000
CANOGRAF_ECU_RX_ID=0x000
