# Profil desky: Waveshare ESP32-S3-Touch-LCD-4.3B, revize 1.1
#
# ESP32-S3-WROOM-1-N16R8, 16 MB flash, 8 MB PSRAM, panel 800x480,
# CAN transceiver TJA1051T/3 primo na desce.
#
# Zmerene udaje, pinout a pasti teto desky:
#   docs/hardware/waveshare-esp32s3-touch-lcd-4.3b.md
#
# Zapina se v config/default.env nebo v local.env:
#   CANOGRAF_BOARD=waveshare-esp32s3-touch-lcd-4.3b
#
# Smi tu byt jen klice, ktere opravdu zavisi na desce. Vse ostatni
# patri do config/default.env.

# TJA1051T/3, pevne spojeny na desce, nikam jinam to nejde
CANOGRAF_CAN_TX_PIN=15
CANOGRAF_CAN_RX_PIN=16

# Na teto desce zbyl volny presne jeden pin. Vsechno ostatni ma panel,
# dotyk, USB, karta, RS485 nebo pamet. Je to jedina moznost pro cokoli
# dalsiho, vcetne hardwarove upravy podsvicenim (podsviceni je dnes jen
# spinac na expanderu CH422G, EXIO2, a stmivat se neda - viz CLAUDE.md,
# zavrene pokusy).
CANOGRAF_SPARE_PIN=6
