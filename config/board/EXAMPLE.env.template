# Profil desky: <jmeno desky a revize>
#
# <cim je deska osazena: modul, pamet, panel, CAN transceiver>
#
# Zmerene udaje a pinout patri do docs/hardware/<soubor>.md - sem jen
# hodnoty, ktere potrebuje preklad.
#
# Novou desku pridas takto:
#   1. zkopiruj tenhle soubor na config/board/<jmeno>.env
#      (jmeno bez mezer, mala pismena, pomlcky)
#   2. vypln hodnoty nize
#   3. zapni profil: CANOGRAF_BOARD=<jmeno> v local.env nebo v
#      config/default.env
#   4. deska s jinym panelem potrebuje i vlastni definici v boards/
#      a jiny `board` v platformio.ini
#
# Soubory s koncovkou .env.template se jako profil nenacitaji, jsou to
# jen vzory. Klic, ktery neni v config/default.env, build zastavi.

# piny CAN transceiveru
CANOGRAF_CAN_TX_PIN=-1
CANOGRAF_CAN_RX_PIN=-1

# volny pin pro cokoli dalsiho, -1 kdyz zadny nezbyl
CANOGRAF_SPARE_PIN=-1

# Pin, ze ktereho jde PWM na rizeni jasu podsviceni, a jeji frekvence.
# -1 znamena, ze deska stmivat neumi - firmware pak stmivani nenabidne.
# Nez sem neco napises, zmer prevodni charakteristiku: nektere desky
# maji polaritu obracenou (vetsi strida = mensi jas) a prepocet v
# ui_bl_duty() v src/ui.c s tim pocita.
CANOGRAF_BL_PWM_PIN=-1
CANOGRAF_BL_PWM_HZ=5000
