# config/default.env - zakladni vrstva konfigurace buildu
#
# Tenhle soubor ma dve role:
#
#   1. vychozi hodnoty, se kterymi se repo postavi bez jakehokoli nastavovani
#   2. SEZNAM VSECH ZNAMYCH KLICU - klic, ktery tu neni, jinde neprojde
#      a build se zastavi s chybou (viz config/README.md)
#
# Novy klic se tedy zavadi tady, vcetne komentare a rozumne vychozi hodnoty.
#
# Format: KLIC=hodnota, radky zacinajici # jsou komentar.
#   - true/false/on/off/yes/no se prelozi na 1/0
#   - "text v uvozovkach" je vzdy retezec, i kdyz vypada jako cislo
#   - cislo, 0x hex a desetinne cislo jdou do makra tak jak jsou
#
# NIC z tohoto souboru se nenastavuje editaci platformio.ini.
# Pro vlastni desku na stole si zaloz local.env (neni v repu),
# vzor je v local.env.example.


# ------------------------------------------------------------------
# Prepinace vrstev
#
# Rikaji, ktery profil se nacte nad touto vrstvou. Prazdna hodnota
# znamena zadny profil. Jmeno, ke kteremu soubor neexistuje, je
# preklep a build se zastavi.
# ------------------------------------------------------------------

# profil desky -> config/board/<hodnota>.env
CANOGRAF_BOARD=waveshare-esp32s3-touch-lcd-4.3b

# profil vozidla -> config/vehicle/<hodnota>.env
CANOGRAF_VEHICLE=x82-trafic3-talento


# ------------------------------------------------------------------
# Ochrana zapisu do ridicich jednotek
#
# Nazvy i semantiku vlastni src/safety.h, duvody jsou v docs/safety.md.
# Cteni z vozidla je zadarmo, zapis muze vuz nevratne vyradit z provozu.
# Vychozi stav je proto ochrana ZAPNUTA.
#
# POZOR na vyznam, cte se to snadno obracene:
#   CANOGRAF_ALLOW_WRITE=0   zapisove funkce nejsou v obrazu, firmware
#                            umi jen cist (vychozi, verejny build)
#   CANOGRAF_ALLOW_WRITE=1   zapis je v obrazu, ale ZA BRANOU - uzivatel
#                            ho musi odemknout sekvenci za behu
#
# Tedy 1 neznamena "zapis povolen", ale "zapis existuje a je chraneny".
#
#   CANOGRAF_WRITE_UNLOCKED=0  brana plati, sekvence je povinna (vychozi)
#   CANOGRAF_WRITE_UNLOCKED=1  brana prelozena otevrena, zadna sekvence -
#                              jen pro vyvoj; bez ALLOW_WRITE=1 to safety.h
#                              odmitne pres #error
#
# Pri CANOGRAF_ALLOW_WRITE=0 skript navic vylouci src/write/ z prekladu,
# aby "neprelozi se" platilo doslova a dalo se to overit na elf souboru.
#
# Delka odemykaci sekvence, pocet pokusu a casovani konfigurovatelne
# nejsou a nebudou - jsou to konstanty SAFETY_SEQ_* v src/safety.h, aby
# se ochrana nedala zeslabit konfiguracnim souborem.
# ------------------------------------------------------------------

CANOGRAF_ALLOW_WRITE=off
CANOGRAF_WRITE_UNLOCKED=off


# ------------------------------------------------------------------
# Jazyk rozhrani
#
# Kod podle ISO 639-1, retezec. Prevod na index do tabulky jazyku dela
# i18n_find() v src/i18n.c; neznamy kod spadne na prvni jazyk v tabulce.
# Zamerne tu neni cislo - index se posune, jakmile nekdo prida jazyk
# doprostred tabulky, a "1" v konfiguraku stejne nikomu nic nerekne.
#
# Dostupne: "en", "cs", "de" (viz lang/README.md).
# Primarni jazyk projektu je anglictina.
#
# Je to jen hodnota po prvnim startu - uzivatel si jazyk prepne v
# nastaveni a volba se ulozi do NVS.
# ------------------------------------------------------------------

CANOGRAF_DEFAULT_LANG="en"


# ------------------------------------------------------------------
# Klice, ktere vlastni profil desky
#
# Tady maji zamerne neplatne hodnoty. Spravne je dosadi
# config/board/<deska>.env. Kdyz nekdo vypne profil desky prazdnym
# CANOGRAF_BOARD, uvidi v tabulce na zacatku buildu -1 a hned vi proc
# mu nejede CAN.
# ------------------------------------------------------------------

# piny CAN transceiveru
CANOGRAF_CAN_TX_PIN=-1
CANOGRAF_CAN_RX_PIN=-1

# jediny pin, ktery na desce zbyl pro cokoli dalsiho; -1 = zadny
CANOGRAF_SPARE_PIN=-1

# ------------------------------------------------------------------
# Stmivani podsviceni
#
# Pin, ze ktereho jde PWM na plosku BL. Je to HARDWAROVA UPRAVA: jeden
# dratek z toho pinu na plosku vedle konektoru LCD pasku. Bez nej PWM
# jde do prazdna.
#
#   CANOGRAF_BL_PWM_PIN=-1   dratek neni; firmware stmivani vubec
#                            nenabidne a podsviceni zustane jen zap/vyp
#   jinak                    cislo pinu, ze ktereho se stmiva
#
# Profil desky dosazuje pin, ktery ta deska pro tenhle ucel ma. Kdo
# dratek nema, prepise si ho na -1 v local.env - firmware pak nema jak
# predstirat, ze stmiva.
#
# Polarita je na teto desce obracena (vetsi strida = mensi jas) a
# prepocet resi ui_bl_duty() v src/ui.c, ne konfigurace.
#
# Frekvence musi byt dost vysoko nad filtrem R11+C11 (casova konstanta
# 10 ms), aby se PWM vyhladila. 5 kHz jsou dve dekady nad nim.
# ------------------------------------------------------------------

CANOGRAF_BL_PWM_PIN=-1
CANOGRAF_BL_PWM_HZ=5000


# ------------------------------------------------------------------
# Klice, ktere vlastni profil vozidla
#
# Stejne jako u desky: spravne hodnoty dosadi
# config/vehicle/<vozidlo>.env.
# ------------------------------------------------------------------

# jmeno pro cloveka, ukazuje se v rozhrani
CANOGRAF_VEHICLE_NAME="(zadny profil vozidla)"

# rychlost diagnosticke sbernice v bitech za sekundu
CANOGRAF_CAN_BITRATE=500000

# adresy ridici jednotky motoru na sbernici, 11 bitu
CANOGRAF_ECU_TX_ID=0x000
CANOGRAF_ECU_RX_ID=0x000


# ------------------------------------------------------------------
# Volitelne moduly
#
# Pripraveno dopredu, aby se na to pri psani nezapomnelo. Zatim to nic
# nezapina - zadny z modulu jeste neexistuje, klice jen drzi misto a
# jmeno. Vychozi je vypnuto u vsech: firmware v aute ma delat jednu vec.
# ------------------------------------------------------------------

# webove rozhrani pres WiFi (prohlizeni hodnot z telefonu)
CANOGRAF_MOD_WEB=off

# emulace ELM327 pro existujici diagnosticke aplikace
CANOGRAF_MOD_ELM327=off

# zapis prubehu hodnot na microSD kartu
CANOGRAF_MOD_SDLOG=off
